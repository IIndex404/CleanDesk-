*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Virtual environments
.venv/
venv/
env/

# Build and packaging output
build/
dist/
release/
*.egg-info/
*.egg
*.spec

# IDE and editor state
.idea/
.vscode/
*.swp
*.swo

# Local configuration and secrets
.env
.env.*
!.env.example
*.local.json
user_data*.json
settings*.json
preferences*.json
